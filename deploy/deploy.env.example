# 复制到 ~/.config/yjlcoder/deploy.env，并执行 chmod 600。
# 这是本机私有配置；不要把真实 QQ 号或 token 提交到 Git。

# 留空时启动器依次搜索 PATH 和 $HOME/.cargo/bin/yjlcoder。
YJLCODER_BIN=

# NapCat 登录和 WebUI。QQ 号可以留空并在网页扫码；token 请自行设置强随机值。
NAPCAT_ACCOUNT=
NAPCAT_WEBUI_TOKEN='replace-with-a-random-token'
NAPCAT_WEBUI_SCHEME=http
NAPCAT_WEBUI_HOST=127.0.0.1
NAPCAT_WEBUI_PORT=6099
NAPCAT_WEBUI_PATH=/webui

# 容器、镜像和 OneBot 连接都可以按机器修改。
NAPCAT_IMAGE=mlikiowa/napcat-docker:latest
NAPCAT_CONTAINER_NAME=napcat
NAPCAT_COMPOSE_PROJECT_NAME=napcat
YJLCODER_ONEBOT_WS_URL=ws://127.0.0.1:6701/onebot/v11/ws
NAPCAT_TIMEZONE=UTC
NAPCAT_RESTART_POLICY=unless-stopped

# 留空使用 deploy/napcat/compose.yml 相邻目录；也可填写任意绝对路径。
NAPCAT_COMPOSE_FILE=
NAPCAT_CONFIG_DIR=
NAPCAT_QQ_DATA_DIR=
NAPCAT_LOG_DIR=

# 自动取当前用户 uid/gid；确有需要时再覆盖。
NAPCAT_UID=
NAPCAT_GID=

# Docker 权限：auto 优先无 sudo，其次免密 sudo，交互终端最后允许提示密码。
DOCKER_BIN=docker
DOCKER_USE_SUDO=auto

# 扫码监听参数；容器内部路径随镜像变化时可直接覆盖。
NAPCAT_QR_SOURCE=/app/napcat/cache/qrcode.png
YJLCODER_QR_DIR=
YJLCODER_QR_POLL_SECONDS=20
YJLCODER_QR_STABLE_ROUNDS=10
YJLCODER_QR_STARTUP_ROUNDS=30
YJLCODER_QR_STARTUP_INTERVAL=10
YJLCODER_OPEN_BIN=xdg-open
YJLCODER_NOTIFY_BIN=notify-send

# systemd 没继承桌面会话时，可取消注释并填写本机真实值；不要假设 :0/wayland-1。
# DISPLAY=:0
# WAYLAND_DISPLAY=wayland-0
